# --- Database ---
DATABASE_URL="postgresql://khan:khan_password@localhost:5432/khan_store?schema=public"

# --- Server ---
NODE_ENV=production
# Set to 1 only if Liara's trusted proxy is the sole direct connection path.
# Keep 0 when clients can connect directly; forwarded headers must not be trusted blindly.
TRUST_PROXY_HOPS=0
PORT=4000
BACKEND_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# --- Online ordering switch ---
# Ordering is enabled by default. Set to "false" to pause it.
# Keep NEXT_PUBLIC_SHOP_ENABLED on the frontend in sync, then redeploy both.
SHOP_ENABLED="true"

# --- Admin panel ---
# Change these before going to production!
ADMIN_PASSWORD="change-me-now"
# Required: generate a unique random secret (at least 32 characters).
ADMIN_JWT_SECRET=""

# --- AI content generation (magazine articles) ---
# Get a key from https://console.anthropic.com — leave empty to disable
# AI-generated drafts (manual article writing still works without it).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Zarinpal payment gateway ---
# Production requires a real merchant ID, an HTTPS callback and sandbox=false.
# Sandbox requires NODE_ENV=development or test. No mock payments exist.
ZARINPAL_SANDBOX=false
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"

# Callback Zarinpal redirects the customer back to after payment.
ZARINPAL_CALLBACK_URL="http://localhost:4000/orders/payment/callback"
